<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permit to Work Form</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #fff;
        }

        .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            padding-left: 20px;
            padding-right: 20px;
            background: #fff;
        }

        h1,
        h2 {
            text-align: center;
            color: #333;
            grid-column: span 2;
        }

        .section {
            margin-bottom: 20px;
            border-top: 2px solid black;
            border-left: 2px solid black;
            border-bottom: 2px solid black;
            padding: 10px;
        }

        .midsection {
            padding: 10px;
        }

        .SecondSection {
            margin-bottom: 20px;
            border: 2px solid black;
        }

        img {
            grid-column: span 2;
            display: block;
            margin: 0 auto 20px;
        }

        .PermitAndDate {
            margin-bottom: 10px;
            display: flex;
            flex-direction: row;
            gap: 60px;
            font-size: medium;
            font-weight: 300;
            width: 100%;
        }

        label {}

        .REQUEST {
            margin-top: 10px;
        }

        .REQUESTHEADING {
            font-weight: bold;
            gap: 25px;
            display: flex;
            width: 100%;
            margin-top: 15px;
        }

        .REQUESTPOINTS {
            margin-top: 10px;
            width: full;
            height: 100%;
            padding-left: 20px;
        }

        .REQUESTPOINTS .request-item {
            padding-bottom: 5px;
            margin-bottom: 10px;
            display: flex;
            flex-direction: column;
        }

        .REQUESTPOINTS .number {
            font-weight: bold;
            margin-right: 10px;
            /* Adjust the gap between number and text */
        }

        .REQUESTPOINTS .label-text {
            display: inline-block;
        }

        .REQUESTPOINTS .dotted-line {
            display: inline-block;
            margin-top: 15px;
        }

        .worktobedone {
            display: flex;
            width: max-content;
            margin-left: 20px;
        }

        .worktobedone img {
            width: 15px;
        }

        .PeriodofPTW {
            display: flex;
            flex-direction: row;
            font-size: medium;
            font-weight: 300;
            width: 100%;
            margin-left: 20px;
            margin-top: 15px
        }

        table,
        th,
        td {
            border: 2px solid black;
            border-collapse: collapse;
        }

        .topcontainer {
            display: grid;
            grid-template-columns: 1fr 2fr 1fr;
            align-items: center;
            gap: 10px;
        }

        .logo {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .title {
            text-align: center;
        }

        .Doc {
            border: 2px solid black;
            margin-top: 6px;
            display: flex;
            justify-content: flex-end;
            margin-bottom: 2px;
            width: max-content;
            margin-left: 60px;
        }

        .Docmin {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            padding: 10px;
            gap: 4px;
        }
    </style>
</head>

<body>
    <div >
        <div class="topcontainer">
            <div class="logo">
                <img src="https://sterlitepower.gis.dhineu.in/assets/images/logo.png" alt="Company Logo">
            </div>
            <div class="title">
                <h1>INTERNAL PERMIT TO WORK</h1>
            </div>
            <div class="Doc">
                <div class="Docmin">
                    <span>Doc. No: - SGL32/O&M/HSE/IPTW 01</span>
                    <span>Rev. No: - 01</span>
                    <span>Date: {{date}}</span>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="section">
                <div class="midsection">
                    <div class="PermitAndDate">
                        <label for="permit">Permit: {{workPermit.permitNo}}</label>
                        <label for="Date">Date: {{permitDate}}</label>
                    </div>
                    <label for="project">Project: {{workPermit.workPackage.line.package.project.name}}</label>
                    <br>
                    <label for="package">Package: {{workPermit.workPackage.line.package.name}}</label>
                    <br>
                    <label for="line">Line: {{workPermit.workPackage.line.name}}</label>
                    <br>
                    <label for="work package">Work Package: {{workPermit.workPackage.name}}</label>
                    <div class="REQUEST">
                        <div class="REQUESTHEADING">
                            <label>I.</label>
                            <label>REQUEST</label>
                        </div>
                        <div class="REQUESTPOINTS">
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">1.</span>
                                    <span class="label-text"><ins>Period of PTW,</ins></span>
                                </div>
                                <div class="PeriodofPTW">
                                    <label>Form: {{permitDate}} </label>
                                    <label>Time: {{workPermit.startTime}} </label>
                                    <label>To: {{permitDate}} </label>
                                    <label>Time: {{workPermit.endTime}} </label>
                                </div>
                            </div>
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">2.</span>
                                    <span class="label-text"><ins>Type Of Works</ins></span>
                                </div>
                                <span class="dotted-line">
                                    {{#each workPermit.workPermitTypeOfWorks}}
                                        {{this.typeOfWork.name}}{{#unless @last}}, {{/unless}}
                                    {{/each}}
                                </span>
                            </div>                            
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">3.</span>
                                    <span class="label-text"><ins>Work to be done:</ins></span>
                                </div>
                                <div class="worktobedone" style="margin-top: 8px;">
                                    {{#each workPermit.workPermitActivities}}
                                        <span>{{this.activity.name}}</span>{{#unless @last}}, {{/unless}}
                                    {{/each}}
                                </div>
                            </div>                            
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">4.</span>
                                    <span class="label-text"><ins>Details of isolation required (if any): </ins>  {{workPermit.detailsOfIsolation}} </span>
                                </div>
                            </div>
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">5.</span>
                                    <span class="label-text"><ins>Precautions taken for safety:</ins> {{workPermit.safetyPrecautions}} </span>
                                </div>
                                <ol type="a">
                                    <li>Approved HIRA is available (Yes / No)</li>
                                    <li>JSA has been done (Yes / No)</li>
                                    <li>TBT Conducted (Yes / No)</li>
                                    <li>Adequate PPEs are available (Yes / No)</li>
                                    <li style="margin-top: 6px;">Any other precautions: …………………………………………</li>
                                </ol>
                            </div>
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">6.</span>
                                    <span class="label-text"><ins>Name & number of persons to execute work</ins></span>
                                </div>
                            </div>
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">7.</span>
                                    <span class="label-text"><ins>After completion of work/PTW scheduled time PTW will
                                            be
                                            returned by requester.</ins></span>
                                </div>
                            </div>
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">8.</span>
                                    <span class="label-text"><ins>If PTW extension is require, the requester will apply
                                            for
                                            extension.</ins></span>
                                </div>
                            </div>
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">9.</span>
                                    <span class="label-text"><ins>For night work requester will verify illumination,
                                            emergency vehicle etc. as per protocol
                                            along with TBT and apply for extension.</ins></span>
                                </div>
                            </div>

                            <div class="request-item">
                                <table style="width:100%">
                                    <tr>
                                        <th></th>
                                        <th style="font-weight: bold;font-size: small;">PTW(Requested by)</th>
                                        <th style="font-weight: bold;font-size: small;">PTW(Reviewed by)(Safety Repr.)
                                        </th>
                                        <th style="font-weight: bold;font-size: small;">PTW (Approved by)(Site Manager)
                                        </th>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;font-size: small; padding: 4px;">Signature</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;font-size: small; padding: 4px;">Name</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold; font-size: small; padding: 4px;">Designation</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="REQUEST">
                        <div class="REQUESTHEADING">
                            <label>II.</label>
                            <label>ISSUE</label>
                        </div>
                        <div class="request-item" style="margin-left: 20px;">
                            <div style="display: flex;margin-top: 10px;">
                                <span class="number">1.</span>
                                <span class="label-text">PTW Allowed,</span>
                            </div>
                            <div class="PeriodofPTW">
                                <label>Form.......................</label>
                                <label>Time:......................</label>
                                <label>To:........................</label>
                                <label>Time.......................</label>
                            </div>
                        </div>
                        <div class="request-item" style="margin-left: 20px;">
                            <div style="display: flex;margin-top: 10px;">
                                <span class="number">2.</span>
                                <span class="label-text">Additional Safety
                                    Precaution...............................................................................</span>
                            </div>
                        </div>
                        <div class="request-item" style="margin-left: 20px;">
                            <div style="display: flex;margin-top: 10px;">
                                <span class="number">3.</span>
                                <span class="label-text">LOTO
                                    implemented...............................................................................</span>
                            </div>
                        </div>
                    </div>
                    <div class="REQUEST">
                        <div class="request-item">
                            <div style="display: flex;margin-top: 10px; flex-direction: column;">
                                <span class="label-text">Signature……………………………………………………………………………</span>
                                <span class="label-text"
                                    style="margin-top: 10px;">Name……………………………………………………………………………………………</span>
                                <span class="label-text"
                                    style="margin-top: 10px;">Designation…………………………………………………………………………</span>
                            </div>
                        </div>
                        <div class="request-item">
                            <div style="display: flex;margin-top: 10px;gap: 100px;">
                                <span class="label-text">Date……………………………</span>
                                <span class="label-text">Time……………………………</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="SecondSection">
                <div class="midsection">
                    <div class="REQUEST">
                        <div class="REQUESTHEADING">
                            <label>III.</label>
                            <label>RECEIPT</label>
                        </div>
                        <div class="request-item" style="margin-left: 25px;">
                            <p>I hereby accept the responsibility for carrying out work on equipment detailed on this
                                permit
                                only and that no attempt will be made by me or by any person under my control to carry
                                out
                                work on any other equipment. I will ensure necessary safety precautions at the work site
                                as
                                per the standard procedure.</p>
                        </div>
                        <div class="REQUEST" style="margin-left: 25px;">
                            <div class="request-item">
                                <div style="display: flex;margin-top: 10px; flex-direction: column;">
                                    <span class="label-text">Signature……………………………………………………………………………</span>
                                    <span class="label-text"
                                        style="margin-top: 10px;">Name……………………………………………………………………………………………</span>
                                    <span class="label-text"
                                        style="margin-top: 10px;">Designation…………………………………………………………………………</span>
                                </div>
                            </div>
                            <div class="request-item">
                                <div style="display: flex;margin-top: 10px;gap: 100px;">
                                    <span class="label-text">Date……………………………</span>
                                    <span class="label-text">Time……………………………</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="REQUEST">
                        <div class="REQUESTHEADING">
                            <label>IV.</label>
                            <label>EXTENSION OF PERMIT TO WORK:</label>
                        </div>
                        <div class="EXTENSIONITEM" style="margin-left: 25px; margin-top: 10px;">
                            <div class="request-item">
                                <div style="display: flex;">
                                    <span class="number">1.</span>
                                    <span class="label-text">Reason for extension:</span>
                                </div>
                            </div>
                            <div class="request-item" style="margin-top: 10px;">
                                <div>
                                    <span class="number">2.</span>
                                    <label>Form Date.......................</label>
                                    <label>Time:......................</label>
                                    <label>To Date:........................</label>
                                    <label>Time.......................</label>
                                </div>
                            </div>
                            <div class="request-item" style="margin-top: 10px;">
                                <div>
                                    <span class="number">3.</span>
                                    <label>Requested by......................................</label>
                                    <label>Issued by.........................................</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="REQUEST">
                        <div class="REQUESTHEADING">
                            <label>V.</label>
                            <label>RETURN OF PERMIT TO WORK:</label>
                        </div>
                        <div class="EXTENSIONITEM" style="margin-left: 25px; margin-top: 10px;">
                            <div class="request-item" style="margin-top: 10px;">
                                <div>
                                    <span class="number">1.</span>
                                    <label>Details of work
                                        done.............................................................................................</label>
                                </div>
                            </div>
                            <div class="request-item" style="margin-top: 10px;">
                                <div style="display: flex;">
                                    <span class="number">2.</span>
                                    <span class="label-text">Restrictions if any, on the equipment:</span>
                                </div>
                            </div>
                            <div class="request-item" style="margin-top: 10px;">
                                <div>
                                    <span class="number">3.</span>
                                    <label>Clearance.............................................................................................</label>
                                </div>
                                <p>I hereby declare that all men and material have been withdrawn and warned that it’s
                                    no
                                    longer safe to work on the equipment specified on this permit and all tools, area,
                                    and
                                    additional earths are clear.</p>
                            </div>
                        </div>
                        <div class="EXTENSIONITEM" style="margin-left: 25px; margin-top: 10px;">
                            <div>
                                <div style="display: flex;">
                                    <span class="label-text">Signature……………………………………………………………………………</span>
                                </div>
                                <div style="display: flex;">
                                    <span class="label-text"
                                        style="margin-top: 10px;">Name……………………………………………………………………………………………</span>
                                </div>
                                <div class="request-item" style="margin-top: 10px;">
                                    <div>
                                        <label>Designation......................................</label>
                                        <label>Return Date & Time.........................................</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="REQUEST">
                        <div class="REQUESTHEADING">
                            <label>VI.</label>
                            <label>CANCELLATION OF PERMIT TO WORK:</label>
                        </div>
                        <div class="EXTENSIONITEM" style="margin-left: 25px; margin-top: 10px;">
                            <div class="request-item" style="margin-top: 10px;">
                                <div style="display: flex;">
                                    <span class="number">1.</span>
                                    <span class="label-text">PTW canceled, and entry made in PTW Register:</span>
                                </div>
                            </div>
                            <div class="request-item" style="margin-top: 10px;">
                                <div>
                                    <span class="number">2.</span>
                                    <label>Sequence of
                                        Normalization.............................................................................................</label>
                                </div>
                            </div>
                        </div>
                        <div class="EXTENSIONITEM" style="margin-left: 25px; margin-top: 10px;">
                            <div style="display: flex;">
                                <span class="label-text">Signature……………………………………………………………………………</span>
                            </div>
                            <div style="display: flex;">
                                <span class="label-text"
                                    style="margin-top: 10px;">Name……………………………………………………………………………………………</span>
                            </div>
                            <div class="request-item" style="margin-top: 10px;">
                                <div>
                                    <label>Designation......................................</label>
                                    <label>Cancellation Date & Time.........................................</label>
                                </div>
                            </div>
                        </div>
                        <div class="EXTENSIONITEM" style="margin-left: 25px; margin-top: 10px;">
                            <div class="request-item" style="margin-top: 10px;">
                                <div style="display: flex;">
                                    <span class="label-text">Note:</span>
                                </div>
                            </div>
                            <div class="request-item" style="margin-top: 10px;margin-left: 25px;">
                                <div style="display: flex;">
                                    <span class="number">1.</span>
                                    <span class="label-text">PTW, request to be approved by Issuer authorized.</span>
                                </div>
                                <div style="display: flex;">
                                    <span class="number">2.</span>
                                    <span class="label-text">Earthing to be done at the place of work, as
                                        applicable.</span>
                                </div>
                                <div style="display: flex;">
                                    <span class="number">3.</span>
                                    <span class="label-text">Applicable Standard Operating Procedure (SOP) to be
                                        followed.</span>
                                </div>
                                <div style="display: flex;">
                                    <span class="number">4.</span>
                                    <span class="label-text">Mandatory Attachment: Toolbox Talk, Job Safety Analysis,
                                        Inspection
                                        checklist of
                                        tools & tackles.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</body>

</html>